# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# MongoDB connection string — point this at a dedicated, demo-only
# database (a local instance, or a separate Atlas/managed cluster — both
# are fine; src/config/isolationGuard.ts only blocks the main Sentry
# repo's own specific production cluster, not managed databases in
# general). Never reuse a connection string from any other deployment.
# If using mongodb+srv://, include an explicit database name in the path
# (e.g. `/sentry-demo`) — without one, the driver silently defaults to
# Atlas's own `test` database.
MONGODB_URI=mongodb://127.0.0.1:27017/sentry-demo

# JWT secrets — use long, random values, unique to this deployment.
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origin(s) allowed to make credentialed requests to this API (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# The admin API is mounted at /api/v1/<this value> instead of the fixed
# /api/v1/admin — defense-in-depth against automated scanners that probe
# common admin paths, NOT a replacement for auth (every admin route is still
# independently gated by requireRole('ADMIN')). Keep it lowercase
# letters/numbers/hyphens only. This is a PUBLIC demo with a published
# demo-admin account, so set this to something non-guessable anyway,
# e.g. `node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"`.
# The frontend must be told the same value via client/.env's
# VITE_ADMIN_ROUTE_PREFIX, or its admin console will call the wrong path.
ADMIN_ROUTE_PREFIX=admin

# Where the repo's docs/ folder lives, for the /docs browser. Leave unset
# for bare-metal dev — it defaults to "one level up from the server/
# directory," which is correct there. Only needs to be set explicitly
# inside Docker (both compose files already do this for you).
DOCS_DIR=

# Required before `npm run seed:demo` / `npm run reset:demo` (or even
# server boot — see src/config/isolationGuard.ts) will touch any
# database. Must literally equal the string below — a deliberate
# confirmation gate, not a secret, to stop a copy-pasted production
# connection string from ever being seeded/reset/booted against by
# accident. See SECURITY.md.
DEMO_DB_CONFIRMATION=yes-this-is-the-demo-database

# Only read by `npm run seed:demo` (src/scripts/seedDemo.ts). These are
# PUBLIC, documented demo credentials — see README.md and SECURITY.md.
# They are not secrets; change them only if you're redeploying this demo
# under your own identities. The script refuses to run if any is unset.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@sentry-demo.example
DEMO_ADMIN_PASSWORD=admin

DEMO_USER_USERNAME=user
DEMO_USER_EMAIL=user@sentry-demo.example
DEMO_USER_PASSWORD=user
