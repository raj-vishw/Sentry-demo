# Copy to .env at this repo's root — docker-compose reads root-level .env
# files automatically for variable substitution, so this one file covers
# both docker-compose.yml (dev) and docker-compose.production.yml. Never
# commit the real .env.

# A dedicated Atlas (or any MongoDB) cluster for this demo only — never
# reuse the main Sentry repo's connection string. MUST include an explicit
# database name (e.g. `/sentry-demo`) — without one, the driver silently
# defaults to Atlas's own `test` database.
#   mongodb+srv://<user>:<pass>@<cluster-host>/sentry-demo?appName=<app>
MONGODB_URI=

# Generate both of these with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Run it twice — the two values must differ from each other, and from any
# value used by any other deployment (including the main Sentry repo).
JWT_SECRET=
JWT_REFRESH_SECRET=

# The real public origin this demo will be served from.
CLIENT_URL=https://demo.sentry.example

# Generate with: node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
# Must be a fresh, unique value — never reuse the main Sentry repo's prefix.
ADMIN_ROUTE_PREFIX=

# Must literally equal this exact string — see server/src/config/isolationGuard.ts.
# Not a secret; it's a deliberate "did you read the warning" confirmation gate.
DEMO_DB_CONFIRMATION=yes-this-is-the-demo-database

# The demo account identities (admin/admin, user/user) are fixed directly
# in both compose files, not read from here — see README.md / SECURITY.md
# for why, and server/.env.example if you want to change them for a
# bare-metal (non-Docker) run.
