# Copy to .env at this repo's root before running:
#   docker compose -f docker-compose.production.yml up -d
# Never commit the real .env. (The dev docker-compose.yml does NOT read
# this file — its secrets are dev-only placeholders hardcoded directly in
# that compose file, same convention as the main Sentry repo's own dev
# compose file.)

# Generate both of these with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Run it twice — the two values must differ from each other, and from any
# value used by any other deployment (including the main Sentry repo).
JWT_SECRET=
JWT_REFRESH_SECRET=

# The real public origin this demo will be served from.
CLIENT_URL=https://demo.sentry.example

# Generate with: node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
# Must be a fresh, unique value — never reuse the main Sentry repo's prefix.
ADMIN_ROUTE_PREFIX=

# Must literally equal this exact string — see server/src/config/isolationGuard.ts.
# Not a secret; it's a deliberate "did you read the warning" confirmation gate.
DEMO_DB_CONFIRMATION=yes-this-is-the-demo-database

# Published, documented demo credentials (see README.md / SECURITY.md) —
# not secrets, but still configurable if you're redeploying this demo
# under your own identities.
DEMO_ADMIN_PASSWORD=SentryDemo!Admin2026
DEMO_USER_PASSWORD=SentryDemo!Player2026
